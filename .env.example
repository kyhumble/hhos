# HHOS local development — SYNTHETIC / NON-PHI ONLY
# Copy to .env and adjust. Never put real patient data in local env files.

NODE_ENV=development
# Platform env: local | staging | production — drives boot guards (Phase 9)
HHOS_ENV=local
LOG_LEVEL=info

# Auth: local JWT stub. Staging/prod must use AUTH_PROVIDER=cognito
AUTH_PROVIDER=local
JWT_SECRET=dev-only-change-me-not-for-prod
JWT_EXPIRES_IN=8h
# SESSION_IDLE_TIMEOUT_MINUTES=480
# MFA_REQUIRED_ROLES=admin,compliance
# Cognito (required when AUTH_PROVIDER=cognito)
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# COGNITO_REGION=us-east-1
# COGNITO_ISSUER=

# Public web origin for invite + physician sign links
# HHOS web defaults to :3100 so it does not collide with other local apps on :3000
WEB_PUBLIC_URL=http://localhost:3100

# Outbound email (Phase 9) — console logs locally; ses for staging/prod
EMAIL_PROVIDER=console
# EMAIL_FROM=noreply@hhos.example
# EMAIL_REPLY_TO=support@hhos.example
# SES_CONFIGURATION_SET=
# EMAIL_EXPOSE_TOKEN=true
# FEATURE_NOTIFICATIONS=true

# Database
DATABASE_URL=postgresql://hhos:hhos_dev@localhost:5432/hhos

# Redis (queues / cache — avoid caching PHI payloads)
REDIS_URL=redis://localhost:6379

# Object storage (MinIO local stand-in for S3+KMS)
# S3_ENDPOINT = internal ops only (API GET/HEAD/DELETE / complete-time hash). Docker DNS ok.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT = device-facing host used to *construct* the presign client (K25 dual S3).
# SigV4 binds Host — never rewrite signed URL hosts after getSignedUrl.
# Device / simulator matrix (API base vs S3 public):
#   iOS Simulator:     API http://localhost:3001     S3 http://127.0.0.1:9000
#   Android Emulator:  API http://10.0.2.2:3001     S3 http://10.0.2.2:9000
#   Physical device:   API http://<LAN-IP>:3001      S3 http://<LAN-IP>:9000
#   API→MinIO in compose: internal S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=hhos-documents
S3_ACCESS_KEY_ID=hhosminio
S3_SECRET_ACCESS_KEY=hhosminio_dev_secret
S3_FORCE_PATH_STYLE=true
# Presign TTL seconds (5–15 min design range; default 600)
# S3_PRESIGN_TTL_SECONDS=600

# Field encryption key (32-byte base64) — generate unique per env; never use this value in prod
# Used for SSN / insurance member ids only — do NOT reuse for photos.
FIELD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Photo envelope KEK (AES-256) — separate from FIELD_ENCRYPTION_KEY (K4).
# 64 hex chars or 32-byte base64. Synthetic local only; never commit real keys.
PHOTO_KEK=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Optional override of kek_key_id stored per photo (default local/v1)
# PHOTO_KEK_ID=local/v1

# API
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3100,http://localhost:3000

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
# local | cognito — when cognito, login uses POST /v1/auth/session
NEXT_PUBLIC_AUTH_PROVIDER=local

# Org defaults
DEFAULT_ORG_TIMEZONE=America/Chicago
# SOC due window in hours from referral received_at (compliance must approve production value)
SOC_DUE_HOURS=48

# Feature flags (features.ts — true only for "1" / "true" / "yes")
# Master switch for wound-photo API (default false when unset) — isWoundPhotosEnabled()
FEATURE_WOUND_PHOTOS=true
# Reserved for later PRs: use featureEnabled('NAME') until thin helpers land with routes
FEATURE_PHOTO_ANNOTATIONS=true
FEATURE_LARGE_WOUND_TASKS=true
# Dev-only ciphertext-via-API fallback; must stay false for prod PHI
FEATURE_PHOTO_BYTES_VIA_API=false
# Phase 3 OASIS-E2 / PDGM advisory (default false when unset)
FEATURE_OASIS=true
# Advisory LUPA visit threshold (not full HIPPS grouper)
LUPA_VISIT_THRESHOLD=4
# Phase 4 Service AI routing / visit tasks / hospitalization alerts
FEATURE_SERVICE_AI=true

# Geotag on clinical photos: FAIL-CLOSED (K8 / K26).
# Only explicit true/1 enables the env half of the dual gate; unset/false = off.
# Must ALSO be enabled in org.settings.photoGeotagEnabled — both required.
PHOTO_GEOTAG_ENABLED=false

# Phase 5 orders / 485 physician e-sign
FEATURE_ORDERS_ESIGN=true

# Phase 6 hospice clinical core
FEATURE_HOSPICE=true

# Phase 7 billing readiness / claim export
FEATURE_BILLING=true

# Phase 8 Postgres RLS (request-scoped org isolation). true in staging/prod.
FEATURE_RLS=false

# App DB role (non-superuser) for FEATURE_RLS=true — created by migration 0008
# DATABASE_URL=postgresql://hhos_app:hhos_app_dev@localhost:5432/hhos
# DATABASE_APP_PASSWORD=hhos_app_dev
