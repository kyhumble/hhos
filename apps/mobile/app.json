{
  "expo": {
    "name": "HHOS Field",
    "slug": "hhos-field",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "hhos",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hhos.field",
      "infoPlist": {
        "NSCameraUsageDescription": "HHOS Field captures clinical wound photographs for care documentation. Gallery import is not used."
      }
    },
    "android": {
      "package": "com.hhos.field",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HHOS Field to capture clinical wound photographs for care documentation.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      "react-native-quick-crypto"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:3001",
      "note": "Phase 2 crypto/camera require expo prebuild or EAS dev client — Expo Go unsupported"
    }
  }
}
